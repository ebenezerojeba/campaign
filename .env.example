# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables. Placeholders only: never commit real values.
# None of these use the VITE_ prefix, so none are ever sent to the browser.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string for a dedicated application user (readWrite on one database).
# Leave unset locally to use the embedded development database in .data/mongo.
# Use a separate database name for demonstrations, e.g. .../apc_lagos_demo, and for production, e.g. .../apc_lagos.
MONGODB_URI=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_HOURS=8

# Public URL of the site (used in email links and CORS). On Vercel this defaults to the production domain.
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated (only if the frontend is hosted on a different domain).
CORS_ORIGINS=

# true includes seeded sample records (clearly labelled) in public figures and lists.
# Never enable on a database that holds real registrations.
DEMO_MODE=false

# Outgoing email over SMTP (Nodemailer). Check the settings without sending
# anything: npm run email:check
# Gmail: smtp.gmail.com, port 465, and an app password (Google Account >
# Security > App passwords), not your normal password. EMAIL_FROM must be an
# address the SMTP account may send as (for Gmail, the account itself).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# true for implicit TLS (465), false for STARTTLS (587). Defaults from the port.
SMTP_SECURE=
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-smtp-or-app-password
EMAIL_FROM=sender@example.com
EMAIL_FROM_NAME=APC Lagos Agent Registration
EMAIL_REPLY_TO=
# New-registration notifications go here.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Required: encrypts NIN, VIN, APC party registration numbers and bank details.
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep a secure backup: encrypted values cannot be read without the same key,
# and every environment that reads the same database needs the same key.
DATA_ENCRYPTION_KEY=

# Public contact details shown in the footer. Leave blank to hide. Use only details supplied by the programme.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_ADDRESS=

# Local development only: where the embedded MongoDB binary is cached.
# MONGOMS_DOWNLOAD_DIR=
